#!/usr/bin/env bash
# Format staged Go files before commit. Enable once with:
#   git config core.hooksPath .githooks
set -euo pipefail

# Only staged, still-present .go files.
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACM -- '*.go')
[ ${#files[@]} -eq 0 ] && exit 0

# golangci-lint fmt matches CI (gofumpt, goimports); plain gofmt without it
if command -v golangci-lint >/dev/null; then
	golangci-lint fmt "${files[@]}"
else
	gofmt -w "${files[@]}"
fi
git add "${files[@]}"   # re-stage anything the formatter rewrote
